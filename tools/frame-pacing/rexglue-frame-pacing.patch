index 00000000..a3ab2f40
--- /dev/null
+++ b/src/graphics/d3d12/texture_heap_ranges.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <cassert>
+#include <cstdint>
+#include <iterator>
+#include <map>
+#include <optional>
+
+namespace rex::graphics::d3d12 {
+
+class TextureHeapRanges {
+ public:
+  explicit TextureHeapRanges(uint64_t size) : capacity_(size), ranges_{{0, size}} {}
+
+  std::optional<uint64_t> Allocate(uint64_t size, uint64_t alignment) {
+    if (!size || !alignment || alignment > capacity_ || (alignment & (alignment - 1))) {
+      return std::nullopt;
+    }
+    for (auto range = ranges_.begin(); range != ranges_.end(); ++range) {
+      const auto [start, length] = *range;
+      const uint64_t offset = (start + alignment - 1) & ~(alignment - 1);
+      const uint64_t padding = offset - start;
+      if (padding > length || size > length - padding) {
+        continue;
+      }
+      ranges_.erase(range);
+      if (padding) {
+        ranges_.emplace(start, padding);
+      }
+      const uint64_t remaining = length - padding - size;
+      if (remaining) {
+        ranges_.emplace(offset + size, remaining);
+      }
+      return offset;
+    }
+    return std::nullopt;
+  }
+
+  void Free(uint64_t offset, uint64_t size) {
+    assert(size && offset <= capacity_ && size <= capacity_ - offset);
+    auto next = ranges_.lower_bound(offset);
+    assert(next == ranges_.end() || offset + size <= next->first);
+    if (next != ranges_.begin()) {
+      auto previous = std::prev(next);
+      assert(previous->first + previous->second <= offset);
+      if (previous->first + previous->second == offset) {
+        offset = previous->first;
+        size += previous->second;
+        ranges_.erase(previous);
+      }
+    }
+    if (next != ranges_.end() && offset + size == next->first) {
+      size += next->second;
+      ranges_.erase(next);
+    }
+    ranges_.emplace(offset, size);
+  }
+
+  bool empty() const {
+    return ranges_.size() == 1 && ranges_.begin()->second == capacity_;
+  }
+
+ private:
+  uint64_t capacity_;
+  std::map<uint64_t, uint64_t> ranges_;
+};
+
+}  // namespace rex::graphics::d3d12
