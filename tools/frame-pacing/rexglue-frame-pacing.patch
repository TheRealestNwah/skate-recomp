+class D3D12TextureCache::TextureHeapPool {
+ public:
+  std::optional<TextureHeapAllocation> Create(ID3D12Device& device, D3D12_HEAP_FLAGS flags,
+                                               const D3D12_RESOURCE_DESC& desc,
+                                               ID3D12Resource** resource) {
+    const auto info = device.GetResourceAllocationInfo(0, 1, &desc);
+    if (!info.SizeInBytes || info.SizeInBytes > kHeapSize ||
+        info.Alignment > D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT) {
+      return std::nullopt;
+    }
+    auto allocation = Reserve(device, flags, info);
+    if (!allocation) {
+      return std::nullopt;
+    }
+    auto& heap = heaps_[allocation->heap_index].value();
+    if (FAILED(device.CreatePlacedResource(heap.resource.Get(), allocation->offset, &desc,
+        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(resource)))) {
+      heap.ranges.Free(allocation->offset, allocation->size);
+      return std::nullopt;
+    }
+    if (!reported_placement_) {
+      REXGPU_INFO("D3D12 texture cache placed its first texture in a shared heap");
+      reported_placement_ = true;
+    }
+    if (allocation->offset < heap.high_water && !reported_reuse_) {
+      REXGPU_INFO("D3D12 texture heap reused space below its previous maximum offset");
+      reported_reuse_ = true;
+    }
+    heap.high_water = std::max(heap.high_water, allocation->offset + allocation->size);
+    return allocation;
+  }
+
+  void Retire(TextureHeapAllocation allocation, Microsoft::WRL::ComPtr<ID3D12Resource> resource,
+              uint64_t last_submission, uint64_t completed_submission) {
+    if (last_submission <= completed_submission) {
+      resource.Reset();
+      heaps_[allocation.heap_index]->ranges.Free(allocation.offset, allocation.size);
+      return;
+    }
+    pending_.push_back({allocation, std::move(resource), last_submission});
+  }
+
+  void Reclaim(uint64_t completed_submission) {
+    std::erase_if(pending_, [&](Retired& retired) {
+      if (retired.last_submission > completed_submission) {
+        return false;
+      }
+      retired.resource.Reset();
+      const auto& allocation = retired.allocation;
+      heaps_[allocation.heap_index]->ranges.Free(allocation.offset, allocation.size);
+      return true;
+    });
+    bool have_empty_heap = false;
+    for (auto& heap : heaps_) {
+      if (heap && heap->ranges.empty()) {
+        if (have_empty_heap) {
+          heap.reset();
+        }
+        have_empty_heap = true;
+      }
+    }
+  }
+
+ private:
+  static constexpr uint64_t kHeapSize = 64ull << 20;
+  static constexpr uint32_t kHeapCount = 8;
+  struct Heap {
+    Microsoft::WRL::ComPtr<ID3D12Heap> resource;
+    TextureHeapRanges ranges{kHeapSize};
+    uint64_t high_water{};
+  };
+  struct Retired {
+    TextureHeapAllocation allocation;
+    Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+    uint64_t last_submission;
+  };
+
+  std::optional<TextureHeapAllocation> Reserve(ID3D12Device& device, D3D12_HEAP_FLAGS flags,
+                                                const D3D12_RESOURCE_ALLOCATION_INFO& info) {
+    uint32_t empty_slot = kHeapCount;
+    for (uint32_t index = 0; index != kHeapCount; ++index) {
+      auto& heap = heaps_[index];
+      if (!heap) {
+        empty_slot = std::min(empty_slot, index);
+      } else if (auto offset = heap->ranges.Allocate(info.SizeInBytes, info.Alignment)) {
+        return TextureHeapAllocation{index, *offset, info.SizeInBytes};
+      }
+    }
+    if (empty_slot == kHeapCount) {
+      return std::nullopt;
+    }
+    Heap heap;
+    const D3D12_HEAP_DESC desc{kHeapSize, ui::d3d12::util::kHeapPropertiesDefault,
+                               D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT,
+                               flags | D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES};
+    if (FAILED(device.CreateHeap(&desc, IID_PPV_ARGS(&heap.resource)))) {
+      return std::nullopt;
+    }
+    auto offset = heap.ranges.Allocate(info.SizeInBytes, info.Alignment);
+    if (!offset) {
+      return std::nullopt;
+    }
+    heaps_[empty_slot].emplace(std::move(heap));
+    return TextureHeapAllocation{empty_slot, *offset, info.SizeInBytes};
+  }
+
+  std::array<std::optional<Heap>, kHeapCount> heaps_;
+  std::vector<Retired> pending_;
+  bool reported_placement_{};
+  bool reported_reuse_{};
+};
